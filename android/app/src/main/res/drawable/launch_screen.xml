<?xml version="1.0" encoding="utf-8"?>
<!-- Shown while the app starts (before React Native draws). Matches the JS splash. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <!-- Same as gradients.splash / gradients.hero in src/theme/colors.ts (270 = top to bottom). -->
            <gradient
                android:angle="270"
                android:startColor="#01B5A8"
                android:centerColor="#017A76"
                android:endColor="#005A5A"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:width="200dp"
        android:height="200dp"
        android:bottom="92dp"
        android:gravity="center"
        android:drawable="@drawable/splash_logo_round" />
</layer-list>
